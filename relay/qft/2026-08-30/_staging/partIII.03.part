\coordinate (v2) at (1.15,0);
\draw[dashed,thick,->] (-2.4,0)--(v1) node[midway,below=4pt] {$p$};
\draw[dashed,thick,->] (v1)--(v2) node[midway,below=4pt] {$p+k$};
\draw[dashed,thick,->] (v2)--(2.4,0) node[midway,below=4pt] {$p'$};
\draw[decorate,decoration={snake,amplitude=1.1pt,segment length=7pt},thick,->] (-1.8,2.1)--(v1) node[midway,left=3pt] {$k$};
\draw[decorate,decoration={snake,amplitude=1.1pt,segment length=7pt},thick,->] (v2)--(1.8,2.1) node[midway,right=3pt] {$k'$};
